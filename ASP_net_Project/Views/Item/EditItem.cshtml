@model Item

<div class="edit-page">

    <h2>Edit Found Item</h2>

    <form asp-action="EditItem" method="post" class="edit-form">

        <input type="hidden" asp-for="Id" />

        <div>
            <label asp-for="Name">Item Name</label>
            <input asp-for="Name" />
        </div>

        <br />

        <div>
            <label asp-for="Description">Description</label>
            <input asp-for="Description" />
        </div>

        <br />

        <div>
            <label asp-for="Location">Enter lost item location</label>

            <input asp-for="Location" list="locations" placeholder="Choose or enter a location" />

            <datalist id="locations">
                <option value="Engineering Building"></option>
                <option value="Library"></option>
                <option value="Cafeteria"></option>
                <option value="Main Gate"></option>
                <option value="Student Affairs"></option>
            </datalist>

            <span asp-validation-for="Location"></span>
        </div>

        <br />

        <div>
            <label asp-for="IsAvailable">Availability</label>
            <input asp-for="IsAvailable" />
        </div>

        <br />

        <input type="submit" value="Save Changes" />

    </form>

</div>